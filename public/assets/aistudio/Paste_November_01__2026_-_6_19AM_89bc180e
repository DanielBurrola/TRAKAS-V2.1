### 🖥️ 2. Pantalla de Visualización Limpia del Alumno (`src/components/StudentMonitor.tsx`)
Rediseñado estéticamente para asemejarse a la pantalla clásica de vectores CRT del **ZOLL Serie M**, mostrando las ondas biológicas de manera nítida.

```typescript
import React, { useEffect, useRef } from 'react';
import { SimulationState } from '../types/simulation';

interface StudentMonitorProps {
  state: SimulationState;
  onUpdateState: (newState: SimulationState) => void;
}

export const StudentMonitor: React.FC<StudentMonitorProps> = ({ state, onUpdateState }) => {
  const canvasRef = useRef<HTMLCanvasElement | null>(null);

  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let animId: number;
    let x = 0;
    const w = canvas.width;
    const h = canvas.height;
    
    ctx.fillStyle = '#010c08';
    ctx.fillRect(0, 0, w, h);

    const drawCurves = () => {
      ctx.fillStyle = 'rgba(1, 12, 8, 0.06)'; // Efecto fósforo clínico
      ctx.fillRect(x, 0, 12, h);

      // Canal 1: ECG Principal
      ctx.strokeStyle = '#10b981'; ctx.lineWidth = 2.5; ctx.beginPath();
      let yEcg = h / 4;
      const ecgCycle = (x % 80) / 80;

      if (state.vitals.waveform === 'SINUS') {
        if (ecgCycle > 0.15 && ecgCycle < 0.18) yEcg -= 55; // Complejo R alto real
        else if (ecgCycle >= 0.18 && ecgCycle < 0.22) yEcg += 12;
      } else if (state.vitals.waveform === 'VFIB') {
        yEcg += Math.sin(x * 0.45) * (14 + Math.random() * 16);
      } else if (state.vitals.waveform === 'ASYSTOLE') {
        yEcg += (Math.random() - 0.5) * 1.1;
      }
      ctx.moveTo(x, yEcg);

      // Canal 2: Capnografía PEtCO2 Fisiológica
      let yCap = h / 1.3;
      const capCycle = (x % 180) / 180;
      if (state.vitals.etco2 > 0 && capCycle > 0.2 && capCycle < 0.6) {
        yCap -= (state.vitals.etco2 * 0.7); // Curva cuadrada alveolar
      }

      x = (x + 2) % w;
      ctx.lineTo(x, yEcg);
      ctx.stroke();

      ctx.strokeStyle = '#22d3ee'; ctx.lineWidth = 2; ctx.beginPath();
      ctx.moveTo(x, yCap);
      ctx.lineTo(x, yCap);
      ctx.stroke();

      animId = requestAnimationFrame(drawCurves);
    };

    drawCurves();
    return () => cancelAnimationFrame(animId);
  }, [state.vitals.waveform, state.vitals.etco2]);

  return (
    <div className="min-h-screen bg-zinc-950 p-4 sm:p-6 flex items-center justify-center font-mono text-emerald-400">
      <div className="w-full max-w-4xl bg-zinc-900 border-4 border-zinc-800 rounded-3xl p-4 sm:p-6 shadow-2xl">
        
        {/* Cabezal de Datos */}
        <div className="flex justify-between items-center border-b border-emerald-950/40 pb-3 mb-4">
          <div>
            <span className="text-[10px] text-emerald-600 block">DERIVACIÓN</span>
            <span className="text-white font-bold text-base">{state.monitorConfig.leadSelected} x1.0</span>
          </div>
          <div className="flex gap-6 text-right">
            <div><span className="text-[10px] text-emerald-600 block">FC (LPM)</span><span className="text-2xl font-black">{state.vitals.hr}</span></div>
            <div><span className="text-[10px] text-teal-600 block">SpO2 (%)</span><span className="text-2xl font-black text-teal-400">{state.vitals.spo2}</span></div>
            <div><span className="text-[10px] text-cyan-600 block">EtCO2</span><span className="text-2xl font-black text-cyan-400">{state.vitals.etco2}</span></div>
          </div>
        </div>

        {/* Pantalla Unificada */}
        <canvas ref={canvasRef} width={700} height={240} className="w-full h-60 sm:h-72 bg-black rounded-xl" />
        
        <div className="mt-4 pt-3 border-t border-zinc-800 flex justify-between text-xs text-zinc-500 font-sans">
          <span>Modo Monitor Activo</span>
          <span>Presión Arterial: {state.vitals.sys}/{state.vitals.dia} mmHg</span>
        </div>

      </div>
    </div>
  );
};
