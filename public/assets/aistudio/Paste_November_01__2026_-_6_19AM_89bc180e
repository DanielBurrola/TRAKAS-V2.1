import React, { useEffect, useState, useRef } from 'react';
import { SimulationState } from '../types/simulation';
import { Zap, RefreshCw, Radio, Eye } from 'lucide-react';

interface StudentMonitorProps {
  state: SimulationState;
  onUpdateState: (newState: SimulationState) => void;
}

export const StudentMonitor: React.FC<StudentMonitorProps> = ({ state, onUpdateState }) => {
  const canvasRef = useRef<HTMLCanvasElement | null>(null);

  // Renderizador dinámico de curvas y artefactos eléctricos (Espigas del Pacer / Marcadores SYNC)
  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let animId: number;
    let x = 0;
    const w = canvas.width;
    const h = canvas.height;

    ctx.fillStyle = '#01110a';
    ctx.fillRect(0, 0, w, h);

    const drawGridAndCurves = () => {
      ctx.fillStyle = 'rgba(1, 17, 10, 0.08)'; // Reticencia de pantalla CRT
      ctx.fillRect(x, 0, 10, h);

      // Trazo Principal ECG
      ctx.strokeStyle = '#10b981'; ctx.lineWidth = 2.5; ctx.beginPath();
      let yEcg = h / 3.5;
      const cycle = (x % 80) / 80;

      // Inyección de espiga eléctrica si el marcapasos está encendido
      if (state.monitorConfig.mode === 'PACER' && state.monitorConfig.pacerOutput > 0) {
        if (x % 90 === 0) {
          ctx.moveTo(x, yEcg + 30);
          ctx.lineTo(x, yEcg - 50); // Espiga de marcapasos transcutáneo pura
          ctx.moveTo(x, yEcg);
          
          // Si el amperaje supera el umbral de captura (ej. 70mA), el QRS se deforma de forma congruente
          if (state.monitorConfig.pacerOutput >= 70 && state.vitals.waveform === 'AV_BLOCK_III') {
            yEcg += 40; // Captura mecánica/eléctrica ventricular ancha
          }
        }
      }

      // Dibujo de ondas nativas según derivación o pala
      if (state.vitals.waveform === 'SINUS' || state.vitals.waveform === 'BRADY_SINUS') {
        if (cycle > 0.15 && cycle < 0.18) {
          yEcg -= 55; // Onda R limpia
          // Si SYNC está activo, dibuja un marcador de sincronización (Flecha o rombo sobre la R)
          if (state.monitorConfig.syncOn) {
            ctx.fillStyle = '#f59e0b';
            ctx.fillRect(x - 2, yEcg - 15, 5, 5);
          }
        }
        else if (cycle >= 0.18 && cycle < 0.22) yEcg += 15;
      } else if (state.vitals.waveform === 'VFIB') {
        yEcg += Math.sin(x * 0.5) * (12 + Math.random() * 15);
      } else if (state.vitals.waveform === 'ASYSTOLE') {
        yEcg += (Math.random() - 0.5) * 1.1;
      }

      ctx.lineTo(x, yEcg);
      ctx.stroke();

      // Trazo 2: Capnografía Cuadrada Avanzada
      ctx.strokeStyle = '#22d3ee'; ctx.lineWidth = 2; ctx.beginPath();
      let yCap = h / 1.25;
      const capCycle = (x % 160) / 160;
      if (state.vitals.etco2 > 0 && capCycle > 0.2 && capCycle < 0.6) {
        yCap -= (state.vitals.etco2 * 0.8); // Caja Alveolar
      }
      ctx.moveTo(x, yCap);
      x = (x + 2) % w;
      ctx.lineTo(x, yCap);
      ctx.stroke();

      animId = requestAnimationFrame(drawGridAndCurves);
    };

    drawGridAndCurves();
    return () => cancelAnimationFrame(animId);
  }, [state.vitals.waveform, state.monitorConfig, state.vitals.etco2]);

  const updateConfig = (key: keyof SimulationState['monitorConfig'], value: any) => {
    onUpdateState({
      ...state,
      monitorConfig: { ...state.monitorConfig, [key]: value }
    });
  };

  const deliverShockOrCardioversion = () => {
    let updated = { ...state };
    updated.monitorConfig.isCharged = false;

    if (updated.monitorConfig.syncOn) {
      // Cardioversión Sincronizada sobre Taquiarritmias (AHA 2025)
      if (updated.vitals.waveform === 'VTACH_SP') {
        updated.vitals.waveform = 'SINUS';
        updated.vitals.hr = 78;
        alert(`¡CARDIOVERSIÓN SINCRONIZADA EXITOSA A ${state.monitorConfig.selectedEnergy}J!`);
      }
    } else {
      // Desfibrilación normal para FV/TVSP
      if (updated.vitals.waveform === 'VFIB') {
        updated.vitals.waveform = 'SINUS';
        updated.vitals.hr = 80;
        alert(`¡DESFIBRILACIÓN ADMINISTRADA DE ${state.monitorConfig.selectedEnergy}J!`);
      }
    }
    onUpdateState(updated);
  };

  return (
    <div className="min-h-screen bg-neutral-950 p-2 sm:p-6 text-emerald-400 font-mono flex flex-col items-center justify-center">
      <div className="w-full max-w-6xl bg-zinc-900 border-4 border-zinc-800 rounded-3xl p-4 sm:p-6 shadow-2xl">
        
        {/* ENCABEZADO HARDWARE: CONMUTADOR PALAS O PARCHES */}
        <div className="flex justify-between items-center bg-zinc-850 px-4 py-2 border border-zinc-700 rounded-xl mb-4 text-xs font-sans text-zinc-300">
          <div className="flex gap-4">
            <label className="flex items-center gap-1.5 cursor-pointer">
              <input type="radio" checked={state.monitorConfig.interfaceMode === 'PADDLES'} onChange={() => updateConfig('interfaceMode', 'PADDLES')} className="accent-emerald-500" />
              <span>PALAS RÍGIDAS</span>
            </label>
            <label className="flex items-center gap-1.5 cursor-pointer">
              <input type="radio" checked={state.monitorConfig.interfaceMode === 'PATCHES'} onChange={() => updateConfig('interfaceMode', 'PATCHES')} className="accent-emerald-500" />
              <span>PARCHES MULTI-FUNCIÓN</span>
            </label>
          </div>
          <div className="text-zinc-500">ZOLL Serie M Plus</div>
        </div>

        <div className="flex flex-col lg:flex-row gap-6">
          
          {/* PANTALLA CRT FISIOLÓGICA */}
          <div className="flex-1 bg-black border-4 border-zinc-950 rounded-2xl p-4 flex flex-col justify-between h-[30rem] shadow-inner relative">
            <div className="flex justify-between border-b border-emerald-950/40 pb-2">
              <div>
                <span className="text-[10px] text-emerald-600 block">DERIVACIÓN SELEC.</span>
                <select 
                  value={state.monitorConfig.leadSelected} 
                  onChange={(e) => updateConfig('leadSelected', e.target.value)}
                  className="bg-zinc-900 text-white font-bold text-sm border border-zinc-700 rounded px-1 py-0.5 outline-none font-sans"
                >
                  {['I', 'II', 'III', 'aVR', 'aVL', 'aVF', 'V1', 'V2', 'V3', 'V4', 'V5', 'V6', 'PADDLES'].map(lead => (
                    <option key={lead} value={lead}>{lead}</option>
                  ))}
                </select>
              </div>

              <div className="grid grid-cols-3 gap-4 text-right">
                <div><span className="text-[10px] text-emerald-600 block">FC (LPM)</span><span className="text-3xl font-black">{state.vitals.hr}</span></div>
                <div><span className="text-[10px] text-teal-600 block">SpO2%</span><span className="text-3xl font-black text-teal-400">{state.vitals.spo2}</span></div>
                <div><span className="text-[10px] text-cyan-600 block">CO2</span><span className="text-3xl font-black text-cyan-400">{state.vitals.etco2}</span></div>
              </div>
            </div>

            {/* Dibujo de Señales en Canvas */}
