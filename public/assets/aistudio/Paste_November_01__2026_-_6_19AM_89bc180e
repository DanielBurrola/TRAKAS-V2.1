    if (direction === 'IMPROVE') {
      updated.vitals.waveform = 'SINUS';
      updated.vitals.hr = 72;
      updated.vitals.spo2 = 98;
      updated.vitals.etco2 = 38;
      updated.vitals.sys = 120;
      updated.vitals.dia = 80;
    } else {
      updated.vitals.waveform = 'VFIB';
      updated.vitals.hr = 0;
      updated.vitals.spo2 = 0;
      updated.vitals.etco2 = 10;
      updated.vitals.sys = 0;
      updated.vitals.dia = 0;
