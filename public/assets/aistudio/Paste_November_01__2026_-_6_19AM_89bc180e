import React, { useState, useEffect } from 'react';
import { SimulationState, WaveformType } from '../types/simulation';
import { Shield, Heart, Activity, Sliders, CheckCircle2, AlertTriangle, Zap } from 'lucide-react';

interface FacilitatorPanelProps {
  state: SimulationState;
  onUpdateState: (newState: SimulationState) => void;
}

export const FacilitatorPanel: React.FC<FacilitatorPanelProps> = ({ state, onUpdateState }) => {
  const [activeTab, setActiveTab] = useState<'presets' | 'fine-tune' | 'student-action'>('presets');

  const setPreset = (type: WaveformType, hr: number, spo2: number, etco2: number, sys: number, dia: number) => {
    onUpdateState({
      ...state,
      vitals: { ...state.vitals, waveform: type, hr, spo2, etco2, sys, dia }
    });
  };

  // Función para modificar parámetros con botones rápidos (+ / -) sin saturar con barras
  const adjustVital = (metric: 'hr' | 'spo2' | 'etco2' | 'sys', amount: number) => {
    let updated = { ...state };
    if (metric === 'hr') updated.vitals.hr = Math.max(0, Math.min(220, updated.vitals.hr + amount));
    if (metric === 'spo2') updated.vitals.spo2 = Math.max(50, Math.min(100, updated.vitals.spo2 + amount));
    if (metric === 'etco2') updated.vitals.etco2 = Math.max(0, Math.min(70, updated.vitals.etco2 + amount));
    if (metric === 'sys') {
      updated.vitals.sys = Math.max(40, Math.min(240, updated.vitals.sys + amount));
      updated.vitals.dia = Math.max(20, Math.min(140, updated.vitals.sys - 40)); // Relación diastólica automática
    }
    onUpdateState(updated);
  };

  // LÓGICA DE EVOLUCIÓN: Aplicar respuesta al tratamiento del alumno
  const evolvePatient = (direction: 'IMPROVE' | 'WORSEN') => {
