          <Zap className={`w-3.5 h-3.5 ${state.monitorConfig.isCharged ? 'text-red-500 animate-pulse' : 'text-zinc-500'}`} />
          <span className="text-slate-300">Alumno en Modo: <strong className="text-white">{state.monitorConfig.mode}</strong></span>
        </div>
      </header>

      {/* Pestañas de Navegación Limpias */}
      <div className="flex space-x-1 bg-slate-900 p-1 rounded-xl mb-6 max-w-md">
        <button onClick={() => setActiveTab('presets')} className={`flex-1 py-2 text-center text-xs font-medium rounded-lg transition-all cursor-pointer ${activeTab === 'presets' ? 'bg-amber-500 text-slate-950 font-bold' : 'text-slate-400 hover:text-white'}`}>Arritmias Base</button>
